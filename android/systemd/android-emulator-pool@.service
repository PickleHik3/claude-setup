[Unit]
Description=Headless Android 16 emulator pool slot (AVD tl16b, read-only, emulator-%i)

[Service]
Type=simple
Environment=ANDROID_SDK_ROOT=%h/Android/Sdk
Environment=ANDROID_HOME=%h/Android/Sdk
# -read-only lets several copies of tl16b run at once; installs and settings reset on stop.
# swangle (ANGLE on SwiftShader): -gpu auto segfaults qemu in host libEGL once apps draw (2026-10-23).
ExecStart=%h/Android/Sdk/emulator/emulator -avd tl16b -read-only -port %i -no-window -no-boot-anim -no-audio -no-metrics -gpu swangle -feature -Vulkan
# adb emu kill returns at once; systemd would then SIGTERM qemu mid graceful shutdown and its gRPC
# event_engine aborts (2026-10-26). Wait for qemu to exit on its own instead.
ExecStop=/bin/sh -c '%h/Android/Sdk/platform-tools/adb -s emulator-%i emu kill; while kill -0 $MAINPID 2>/dev/null; do sleep 1; done'
# Read-only slots often segfault while shutting down; their ~1.3 GB core dumps are noise.
LimitCORE=0
TimeoutStopSec=60
Restart=on-failure
RestartSec=10
