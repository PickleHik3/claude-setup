#!/usr/bin/env bash
# ad — drive Android devices: pick and connect a device, boot the emulator, look and act fast
# over adb, set test conditions, read logs.
# Target: `ad -s NAME|SERIAL|MODEL|emu|emu2 CMD`, else $ANDROID_SERIAL, else the only device.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGETS="${AD_TARGETS:-$HOME/.config/ad/targets}"

# One adb server (5037) for every agent; a private server hides devices from the rest.
unset ANDROID_ADB_SERVER_PORT ADB_SERVER_SOCKET

die() { echo -e "ad: $*" >&2; exit 1; }

devices() { adb devices -l 2>/dev/null | awk 'NR>1 && $2=="device"'; }

# Address of a named target from $TARGETS ("name host:port"); a host that is not an IP is
# resolved through Tailscale (MagicDNS names like nothingphone2).
target_addr() {
  local host port ip
  [ -f "$TARGETS" ] || return 1
  read -r host port <<<"$(awk -v n="$1" '!/^#/ && $1==n {split($2,a,":"); print a[1], a[2]; exit}' "$TARGETS")"
  [ -n "$host" ] || return 1
  if [[ "$host" =~ ^[0-9.]+$ ]]; then ip="$host"
  else ip="$(tailscale ip -4 "$host" 2>/dev/null | head -1)"; [ -n "$ip" ] || die "tailscale cannot resolve '$host' (is it on the tailnet? tailscale status)"; fi
  echo "$ip:${port:-5555}"
}

# A named target's KEY=VALUE field from $TARGETS ("name host:port drop=termux ..."), or nothing.
target_field() {
  [ -f "$TARGETS" ] || return 0
  awk -v n="$1" -v k="$2" '!/^#/ && $1==n { for (i = 3; i <= NF; i++) { if ($i ~ /^#/) break; if (index($i, k "=") == 1) { print substr($i, length(k) + 2); exit } } }' "$TARGETS"
}

# Connect a named target if it is not already a usable device; drops a stale offline entry.
connect_target() {
  local addr="$1" i
  devices | awk -v a="$addr" '$1==a {f=1} END {exit !f}' && { echo "$addr"; return; }
  adb disconnect "$addr" >/dev/null 2>&1 || true
  adb connect "$addr" >/dev/null 2>&1 || true
  for i in $(seq 1 10); do
    devices | awk -v a="$addr" '$1==a {f=1} END {exit !f}' && { echo "$addr"; return; }
    sleep 1
  done
  die "cannot reach $addr over adb. On the phone, port 5555 closes on reboot: re-enable it with 'adb tcpip 5555' over USB or wireless debugging"
}

# Local emulator slots. `emu` is AVD tl16 (writable, keeps installs and settings between boots).
# emu2 is a -read-only copy of AVD tl16b, so it can run beside emu; it loses installs
# and settings when stopped. Each runs as a user service; the pool ones are one template unit.
SLOTS="emu emu2"
MEMINFO="${AD_MEMINFO:-/proc/meminfo}"
MIN_FREE_GIB=8               # refuse a start when less than this much memory is available
BOOT_GAP=20                  # seconds between two emulator launches (read-only copies crash if closer)
slot_field() { # <slot> serial|unit|avd; empty when <slot> is not a slot
  case "$1:$2" in
    emu:serial) echo emulator-5554 ;;  emu:unit) echo android-emulator ;;            emu:avd) echo tl16 ;;
    emu2:serial) echo emulator-5556 ;; emu2:unit) echo android-emulator-pool@5556 ;; emu2:avd) echo tl16b ;;
  esac
}
is_slot() { [ -n "$(slot_field "$1" serial)" ]; }
slot_up() { devices | awk -v s="$(slot_field "$1" serial)" '$1==s {f=1} END {exit !f}'; }
slot_active() { systemctl --user is-active -q "$(slot_field "$1" unit)"; }
mem_free_gib() { awk '/^MemAvailable:/ {print int($2 / 1048576)}' "$MEMINFO"; }

# Boot a slot through its user service (only `ad emu start` calls this).
ensure_emu() { # <slot>
  local slot="$1" serial unit i t0 left
  serial="$(slot_field "$slot" serial)"; unit="$(slot_field "$slot" unit)"
  systemctl --user cat "$unit" >/dev/null 2>&1 || die "no $unit user service on this machine"
  if ! slot_up "$slot"; then
    echo "ad: starting $slot (about 80 s)" >&2
    # One launch at a time across every session, and none within BOOT_GAP s of the last one.
    mkdir -p "$LEASES"
    (
      flock -w 600 8 || die "another session is booting an emulator; try again in a minute"
      t0=$(date +%s)
      systemctl --user start "$unit"
      for i in $(seq 1 120); do slot_up "$slot" && break; sleep 1; done
      left=$(( BOOT_GAP - ($(date +%s) - t0) )); [ $left -gt 0 ] && sleep $left
      exit 0
    ) 8>"$LEASES/.boot"
  fi
  for i in $(seq 1 180); do
    if [ "$(adb -s "$serial" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = "1" ]; then
      # A CPU-rendered cold boot often raises "System UI isn't responding"; answer Wait.
      for i in $(seq 1 20); do
        if adb -s "$serial" shell dumpsys window 2>/dev/null | grep -q 'mCurrentFocus=.*Application Not Responding'; then
          S="$serial" ui_dump --find aerr_wait --xy >/dev/null 2>&1 \
            && adb -s "$serial" shell input tap $(S="$serial" ui_dump --find aerr_wait --xy) \
            && echo "ad: dismissed a 'not responding' dialog after boot" >&2
        fi
        sleep 1
      done
      echo "$serial"; return
    fi
    sleep 1
  done
  die "$slot did not finish booting in 5 min: journalctl --user -u $unit"
}

# Resolve the target to one serial: named target, an emulator slot, exact serial, or a unique
# case-insensitive match on the `adb devices -l` line (model, product, device).
pick() {
  local want="$1" list n m addr
  if is_slot "$want"; then
    slot_up "$want" && { slot_field "$want" serial; return; }
    die "$want is not running. Start it with 'ad -s $want emu start' (lease it first), and run 'ad -s $want emu stop' when you are done$([ "$(slot_field "$want" avd)" = tl16b ] && echo ". It is read-only: a fresh start has nothing from earlier runs, so install your build again")"
  fi
  if [ -n "$want" ] && addr="$(target_addr "$want")"; then connect_target "$addr"; return; fi
  list="$(devices)"
  n="$(grep -c . <<<"$list" || true)"
  if [ -z "$want" ]; then
    [ "$n" = 1 ] && { awk '{print $1}' <<<"$list"; return; }
    [ "$n" = 0 ] && die "no device connected. Named targets: $(names). Local: ad -s emu emu start"
    die "$n devices connected; choose one with -s NAME|SERIAL:\n$list"
  fi
  awk -v w="$want" '$1==w {f=1} END {exit !f}' <<<"$list" && { echo "$want"; return; }
  m="$(grep -iF -- "$want" <<<"$list" || true)"
  n="$(grep -c . <<<"$m" || true)"
  [ "$n" = 1 ] && { awk '{print $1}' <<<"$m"; return; }
  [ "$n" = 0 ] && die "no device or named target matches '$want'. Named targets: $(names)\n${list:-  (none connected)}"
  die "'$want' matches $n devices; use the exact serial:\n$m"
}

# --- leases: one driver per device at a time, across every session and account -------------
# A lease is a file per device key (an emulator slot, a named target, or a serial) under $LEASES, written
# under flock. Commands that change a device need its lease; looking needs none. The owner is
# the Claude session (subagents share it), or $AD_OWNER, or "manual" for a person at a shell.
LEASES="${AD_LEASES:-$HOME/.local/state/ad/leases}"
OWNER="${AD_OWNER:-${CLAUDE_CODE_SESSION_ID:-manual}}"
LEASE_IDLE=$((10 * 60))      # a lease lives at least this long after its holder's last command

lease_key() { # key for the target string, or for a resolved serial
  local k
  is_slot "$1" && { echo "$1"; return; }
  for k in $SLOTS; do [ "$(slot_field "$k" serial)" = "$1" ] && { echo "$k"; return; }; done
  echo "${1//[^A-Za-z0-9._-]/_}"
}
lease_file() { echo "$LEASES/$1"; }
lease_get() { # <key> <field>
  local f; f="$(lease_file "$1")"; [ -f "$f" ] && sed -n "s/^$2=//p" "$f" | head -1; return 0
}
lease_live() { # <key>: true when someone holds an unexpired lease
  local exp; exp="$(lease_get "$1" expires)"; [ -n "$exp" ] && [ "$exp" -gt "$(date +%s)" ]
}
lease_mine() { lease_live "$1" && [ "$(lease_get "$1" owner)" = "$OWNER" ]; }
lease_write() { # <key> <expires> <purpose> <started_emu>   (call under lease_locked)
  local since; since="$(lease_get "$1" since)"; [ -n "$since" ] || since="$(date +%s)"
  mkdir -p "$LEASES"
  printf 'owner=%s\npurpose=%s\nexpires=%s\nstarted_emu=%s\nsince=%s\n' \
    "$OWNER" "$3" "$2" "${4:-0}" "$since" > "$(lease_file "$1").tmp"
  mv "$(lease_file "$1").tmp" "$(lease_file "$1")"
}
lease_try() { # <key> <minutes> <purpose>: take or extend; exit 3 when someone else holds it
  if lease_live "$1" && ! lease_mine "$1"; then return 3; fi
  # An expired lease from someone else is replaced, but whether a lease started the emulator
  # carries over, so whoever releases last still shuts down an emulator nobody stopped.
  local started; started="$(lease_get "$1" started_emu)"
  lease_mine "$1" || rm -f "$(lease_file "$1")"
  lease_write "$1" $(( $(date +%s) + $2 * 60 )) "$3" "$started"
}
lease_try_any() { # <minutes> <purpose>: lease the first free slot, a running one first; prints it
  local k pass
  for pass in running any; do
    for k in emu2 emu; do   # the pool slot first, so throwaway work stays off emu's kept state
      [ $pass = running ] && ! slot_up "$k" && continue
      lease_live "$k" && continue
      lease_try "$k" "$1" "$2" && { echo "$k"; return 0; }
    done
  done
  return 1
}
lease_locked() { mkdir -p "$LEASES"; ( flock -w 10 9 || die "lease lock busy"; "$@" ) 9>"$LEASES/.lock"; }
lease_holder() { # one line describing the holder of <key>
  local exp; exp="$(lease_get "$1" expires)"; local left=$(( ${exp:-0} - $(date +%s) ))
  echo "$1 is leased by $(lease_get "$1" owner) for \"$(lease_get "$1" purpose)\", $((left / 60)) min left"
}
lease_touch() { # extend my lease on every command that changes the device
  local key="$1" exp now; now=$(date +%s); exp="$(lease_get "$key" expires)"; exp="${exp:-0}"
  [ "$exp" -lt $((now + LEASE_IDLE)) ] && lease_write "$key" $((now + LEASE_IDLE)) "$(lease_get "$key" purpose)" "$(lease_get "$key" started_emu)"
  return 0
}
need_lease() { # <key>: die unless this session holds it
  [ "${AD_NO_LEASE:-0}" = 1 ] && return
  lease_mine "$1" && { lease_locked lease_touch "$1"; if is_slot "$1"; then seen_check "$1"; fi; return 0; }
  if lease_live "$1"; then die "$(lease_holder "$1"). Wait with: ad -s $1 lease acquire --wait \"<purpose>\""; fi
  local was=""; is_slot "$1" && [ -f "$SEEN/$1.$OWNER" ] && was=" You drove $1 before: it may have been reaped or used by another session since, so check what is installed before you rely on it."
  die "no lease on $1. Take it first: ad -s $1 lease acquire \"<purpose>\" (release it when done).$was"
}

# A resumed agent must not trust a slot it left: pool slots reset on every restart, and another
# session may have driven any slot in between. Each driver leaves a token in the emulator's
# /data/local/tmp and keeps a copy in $SEEN; a missing or foreign token means the state it left is
# gone (a snapshot boot keeps the kernel boot id, so only a mark inside the device shows a reset).
# The first command after such a change is refused once.
SEEN="$LEASES/.seen"
TOKEN_PATH=/data/local/tmp/.ad-token
slot_token() { adb -s "$(slot_field "$1" serial)" shell cat "$TOKEN_PATH" 2>/dev/null | tr -d '\r' || true; }
seen_mark() { # <slot>: record this session as the slot's last driver
  local t; t="${OWNER//[^A-Za-z0-9-]/_}.$(date +%s%N)"
  adb -s "$(slot_field "$1" serial)" shell "echo $t > $TOKEN_PATH" 2>/dev/null || true
  mkdir -p "$SEEN"; echo "$OWNER" > "$SEEN/$1.last"; echo "$t" > "$SEEN/$1.$OWNER"
}
seen_check() { # <slot>
  slot_up "$1" || return 0
  local cur mine last why=""; cur="$(slot_token "$1")"
  mine="$(cat "$SEEN/$1.$OWNER" 2>/dev/null || true)"; last="$(cat "$SEEN/$1.last" 2>/dev/null || true)"
  [ -n "$mine" ] && [ "$mine" = "$cur" ] && [ "$last" = "$OWNER" ] && return 0
  if [ -n "$mine" ]; then
    if [ -n "$last" ] && [ "$last" != "$OWNER" ]; then
      why="another session drove $1 since your last command: what you installed or set there may be changed or gone"
    elif [ "$(slot_field "$1" avd)" = tl16b ]; then
      why="$1 restarted since your last command, and it is read-only: everything you installed, cleared or set there is gone"
    else
      why="$1's data was reset since your last command: what you installed or set there is gone"
    fi
  fi
  seen_mark "$1"
  [ -z "$why" ] || die "$why. Check with 'ad -s $1 pkgs' and 'ad -s $1 top', reinstall or redo setup, then rerun (this warning shows once)."
}
lease_cmd() { # ad -s KEY lease acquire [--for MIN] [--wait] "purpose" | acquire --any ... | release | status
  local key="$1" sub="${2:-status}"; shift 2 || true
  case "$sub" in
    acquire)
      local mins=30 wait=0 purpose="" any=0 got
      while [ $# -gt 0 ]; do case "$1" in --for) mins="$2"; shift 2 ;; --wait) wait=1; shift ;; --any) any=1; shift ;; *) purpose="$1"; shift ;; esac; done
      [ -n "$purpose" ] || die "say what the lease is for: ad -s $key lease acquire \"<purpose>\""
      local deadline=$(( $(date +%s) + 30 * 60 ))
      if [ $any = 1 ]; then
        is_slot "$key" || die "--any picks an emulator slot; drop -s $key, or use -s emu"
        while :; do
          if got="$(lease_locked lease_try_any "$mins" "$purpose")"; then
            echo "leased $got for $mins min: $purpose"; return
          fi
          [ $wait = 1 ] && [ "$(date +%s)" -lt $deadline ] || die "every emulator slot is leased:\n$(lease_status)"
          echo "ad: every emulator slot is leased; waiting" >&2; sleep 20
        done
      fi
      while :; do
        if lease_locked lease_try "$key" "$mins" "$purpose"; then
          echo "leased $key for $mins min: $purpose"; return
        fi
        [ $wait = 1 ] && [ "$(date +%s)" -lt $deadline ] || die "$(lease_holder "$key")"
        echo "ad: $(lease_holder "$key"); waiting" >&2; sleep 20
      done ;;
    release)
      lease_mine "$key" || { lease_live "$key" && die "$(lease_holder "$key"); not yours to release"; echo "no lease on $key"; return; }
      if is_slot "$key" && [ "$(lease_get "$key" started_emu)" = 1 ]; then
        systemctl --user stop "$(slot_field "$key" unit)" && echo "$key stopped (this lease started it)"
      fi
      rm -f "$(lease_file "$key")"; echo "released $key" ;;
    status) lease_status ;;
    *) die "usage: ad -s DEVICE lease acquire [--for MIN] [--wait] \"purpose\" | release | status\n       ad lease acquire --any [--for MIN] [--wait] \"purpose\"   (first free emulator slot)" ;;
  esac
}
lease_status() {
  local f k any=0
  for f in "$LEASES"/*; do
    [ -f "$f" ] || continue; k="$(basename "$f")"; any=1
    if lease_live "$k"; then echo "$(lease_holder "$k")$([ "$(lease_get "$k" owner)" = "$OWNER" ] && echo ' (you)')"
    else echo "$k: free (expired lease from $(lease_get "$k" owner))"; fi
  done
  [ $any = 1 ] || echo "no leases"
}

names() { [ -f "$TARGETS" ] && awk '!/^#/ && NF {printf "%s ", $1}' "$TARGETS"; echo "emu emu2"; }

TARGET="${ANDROID_SERIAL:-}"
if [ "${1:-}" = "-s" ]; then TARGET="${2:?ad: -s needs a name, serial, model or emu|emu2}"; shift 2; fi
cmd="${1:-help}"; shift || true

case "$cmd" in
    lease) lease_cmd "$(lease_key "${TARGET:-emu}")" "$@"; exit ;;
    emu)   if [ "${1:-}" = start ] || [ "${1:-}" = stop ]; then
             SLOT="$(lease_key "${TARGET:-emu}")"
             is_slot "$SLOT" || die "emu start|stop needs -s emu|emu2"
             need_lease "$SLOT"
           fi ;;
esac
case "$cmd" in help|devices|emu) S="" ;; *) S="$(pick "$TARGET")" ;; esac

# Looking needs no lease; anything that can change the device does. A getter (night, font, ...
# with no value) only looks.
case "$cmd" in
    help|devices|emu|serial|status|top|ui|find|shot|zoom|record|logcat|crash|pkgs|perms) ;;
    night|font|anim|airplane|density|size) [ $# -eq 0 ] || need_lease "$(lease_key "${TARGET:-$S}")" ;;
    locale) [ $# -le 1 ] || need_lease "$(lease_key "${TARGET:-$S}")" ;;
  *) need_lease "$(lease_key "${TARGET:-$S}")" ;;
esac
a() { adb -s "$S" "$@"; }
sh_() { adb -s "$S" shell "$@"; }

# Install an APK on a Tailscale target through the private GitHub repo $DROP_REPO instead of
# pushing it over adb: the relay to a phone can crawl (11-33 KB/s seen on phone), while both ends
# reach GitHub fast. Upload here → the device's Termux downloads it over its own connection (ssh
# alias from the target's drop= field) → `pm install` reads it through run-as of the Termux app
# (a debuggable/staging build), or from /sdcard when Termux has storage access. The asset and the
# device copy are deleted afterwards. Needs `gh` logged in here; the device needs only curl: it
# fetches a short-lived signed link resolved here, because `gh release download` on a phone ran
# 4-8x slower than curl of the same link (0.55-1.1 vs 4-5 MB/s on pong, 2026-11-12).
DROP_REPO="${AD_DROP_REPO:-}"   # a private GitHub repo you own, as OWNER/NAME; needed for drop= targets
DROP_RELEASE="${AD_DROP_RELEASE:-inbox}"
drop_install() {
  [ -n "$DROP_REPO" ] || die "drop: set AD_DROP_REPO=OWNER/NAME (a private repo you own) or install with --direct"
  local apk="$1" alias="$2" pkg="${3:-com.termux}" size sha asset tmp home dir r out id url t0
  size="$(stat -c %s "$apk")"
  sha="$(sha256sum "$apk" | cut -c1-12)"
  asset="${TARGET}-${sha}-$(basename "$apk" | tr -c 'A-Za-z0-9._\n-' '_')"
  tmp="$(mktemp -d)"; ln "$apk" "$tmp/$asset" 2>/dev/null || cp "$apk" "$tmp/$asset"
  echo "ad: drop: uploading $(basename "$apk") ($((size / 1048576)) MB) to $DROP_REPO@$DROP_RELEASE as $asset" >&2
  gh release upload "$DROP_RELEASE" "$tmp/$asset" --repo "$DROP_REPO" --clobber >/dev/null || { rm -rf "$tmp"; die "drop: upload to $DROP_REPO failed (gh auth status?)"; }
  rm -rf "$tmp"
  id="$(gh api "repos/$DROP_REPO/releases/tags/$DROP_RELEASE" --jq ".assets[] | select(.name == \"$asset\") | .id")"
  [ -n "$id" ] || die "drop: uploaded $asset but cannot find it in $DROP_REPO@$DROP_RELEASE"
  home="/data/data/$pkg/files/home"
  # Where the device keeps it: Termux's home (read back through run-as) or shared storage.
  if sh_ "run-as $pkg true" >/dev/null 2>&1; then dir="$home/drops"; else dir="/sdcard/Download/device-drops"; fi
  # The ssh login shell may be fish (or any shell) with no Termux PATH: start bash through the
  # system sh, found next to $SHELL in Termux's prefix, with PATH, HOME and TMPDIR set.
  local rbash='/system/bin/sh -c '"'"'d=${SHELL%/*}; [ -x "$d/bash" ] || d=/data/data/com.termux/files/usr/bin; export PREFIX=${d%/bin}; export PATH=$d:$PATH TMPDIR=$PREFIX/tmp HOME=${HOME:-${PREFIX%/usr}/home}; exec "$d/bash" -s'"'"''
  out=""
  t0=$SECONDS
  for r in 1 2; do   # a phone that just changed network fails its first GitHub call: retry once
    # The signed link (valid a few minutes) is resolved per attempt; the token never leaves here.
    url="$(curl -sS -o /dev/null -w '%{redirect_url}' -H "Authorization: Bearer $(gh auth token)" \
      -H 'Accept: application/octet-stream' "https://api.github.com/repos/$DROP_REPO/releases/assets/$id")"
    [ -n "$url" ] || { out="could not resolve a download link for asset $id"; continue; }
    out="$(ssh -o ConnectTimeout=20 "$alias" "$rbash" <<EOS 2>&1
set -e
mkdir -p '$dir' && cd '$dir'
curl -fsS --max-time 600 -o '$asset' '$url'
[ "\$(stat -c %s '$asset')" = '$size' ] && echo DROP_OK
EOS
)" && grep -q DROP_OK <<<"$out" && break
    [ "$r" = 1 ] && { echo "ad: drop: device download failed, retrying once" >&2; sleep 3; }
  done
  if ! grep -q DROP_OK <<<"$out"; then
    gh release delete-asset "$DROP_RELEASE" "$asset" --repo "$DROP_REPO" -y >/dev/null 2>&1 || true
    die "drop: the device could not fetch $asset over ssh '$alias':\n$out\nIf Termux has no run-as (release build) and no storage access, install over adb: ad install APK --direct"
  fi
  echo "ad: drop: device download took $((SECONDS - t0)) s; installing" >&2
  if [ "$dir" = "$home/drops" ]; then
    out="$(sh_ "run-as $pkg cat '$dir/$asset' | pm install -r -S $size" 2>&1 | tr -d '\r')"
  else
    out="$(sh_ "cat '$dir/$asset' | pm install -r -S $size" 2>&1 | tr -d '\r')"
  fi
  ssh -o ConnectTimeout=20 "$alias" "$rbash" <<<"rm -f '$dir/$asset'" >/dev/null 2>&1 || true
  gh release delete-asset "$DROP_RELEASE" "$asset" --repo "$DROP_REPO" -y >/dev/null 2>&1 || true
  echo "$out"
  grep -q '^Success' <<<"$out" || die "drop: pm install did not succeed"
}

pkg_of_apk() {
  local aapt; aapt="$(ls -d "$HOME"/Android/Sdk/build-tools/*/aapt2 2>/dev/null | sort -V | tail -1)"
  [ -n "$aapt" ] || return 1
  "$aapt" dump badging "$1" 2>/dev/null | sed -n "s/^package: name='\([^']*\)'.*/\1/p"
}

ui_dump() {
  sh_ uiautomator dump /sdcard/ad-ui.xml >/dev/null 2>&1 || die "uiautomator dump failed (screen animating? retry, or 'ad anim 0')"
  a exec-out cat /sdcard/ad-ui.xml | python3 "$HERE/ui.py" "$@"
}

# Escape text for `input text`.
esc() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/ /%s/g' -e "s/'/\\\\'/g" -e 's/"/\\"/g' -e 's/&/\\&/g' -e 's/</\\</g' -e 's/>/\\>/g' -e 's/(/\\(/g' -e 's/)/\\)/g' -e 's/|/\\|/g' -e 's/;/\;/g' -e 's/\*/\\*/g' -e 's/~/\\~/g'
}

# "x y" as is; "text" -> center of the first matching node.
resolve_xy() {
  if [[ "$1" =~ ^[0-9]+$ ]] && [[ "${2:-}" =~ ^[0-9]+$ ]]; then echo "$1 $2"; return; fi
  local xy; xy="$(ui_dump --find "$1" --xy)"
  [ -n "$xy" ] || die "no node matching '$1' on screen (run 'ad ui')"
  echo "$xy"
}

case "$cmd" in
  # --- devices -----------------------------------------------------------------
  devices) # connected devices, then named targets that are not connected
    adb devices -l | awk 'NR>1 && NF'
    [ -f "$TARGETS" ] && awk '!/^#/ && NF {print "(target) " $1 " " $2}' "$TARGETS"
    line=""; for k in $SLOTS; do   # one line: each slot, up or stopped, and who holds it
      if slot_up "$k"; then st=up; else st=stopped; fi
      if lease_live "$k"; then st="$st, leased"; else st="$st, free"; fi
      line="$line$k ($st)  "
    done
    echo "emulators: ${line}| start: ad -s emuN emu start" ;;
  emu)     # ad -s SLOT emu start|stop, ad emu reap   (local emulators; only `start` boots one)
    sub="${1:-}"; shift || true
    case "$sub" in
      start)
             running=0; slot_up "$SLOT" && running=1
             if [ $running = 0 ]; then
               free="$(mem_free_gib)"
               [ "$free" -ge "$MIN_FREE_GIB" ] || die "only $free GiB of memory is available (an emulator needs about 6, and $MIN_FREE_GIB must stay free); stop an emulator you no longer need"
             fi
             ensure_emu "$SLOT"
             seen_mark "$SLOT"   # a boot this session made is no surprise to it
             [ $running = 0 ] && lease_locked lease_write "$SLOT" "$(lease_get "$SLOT" expires)" "$(lease_get "$SLOT" purpose)" 1 ;;
      stop)  systemctl --user stop "$(slot_field "$SLOT" unit)" && echo "$SLOT stopped" ;;
      reap)  # run by emu-reaper.timer: stop each emulator that no live lease holds
        find "$SEEN" -type f -mtime +2 -delete 2>/dev/null || true
        for k in $SLOTS; do
          slot_active "$k" || continue
          lease_live "$k" && continue
          up="$(systemctl --user show -p ActiveEnterTimestamp --value "$(slot_field "$k" unit)")"
          [ $(( $(date +%s) - $(date -d "$up" +%s) )) -lt $((15 * 60)) ] && continue   # just booted
          pgrep -f 'gradle.*connected[A-Za-z]*AndroidTest' >/dev/null && continue      # instrumentation run
          echo "ad: no live lease on $k; stopping it (up since $up)"
          rm -f "$(lease_file "$k")"
          systemctl --user stop "$(slot_field "$k" unit)"
        done ;;
      *)     die "usage: ad -s emu|emu2 emu start|stop   (ad emu reap: timer)" ;;
    esac ;;
  serial)  echo "$S" ;;   # for ANDROID_SERIAL
  status)  echo "serial:  $S"
           echo "model:   $(sh_ getprop ro.product.manufacturer | tr -d '\r') $(sh_ getprop ro.product.model | tr -d '\r')"
           echo "android: $(sh_ getprop ro.build.version.release | tr -d '\r') (API $(sh_ getprop ro.build.version.sdk | tr -d '\r'), $(sh_ getprop ro.product.cpu.abi | tr -d '\r'))"
           sh_ wm size | tr -d '\r'; sh_ wm density | tr -d '\r'
           sh_ dumpsys battery 2>/dev/null | grep -E '^ *level' | sed 's/^ */battery /' || true ;;

  # --- acting (fast adb input; never changes the keyboard) ------------------------------
  tap)     xy="$(resolve_xy "$@")" || exit 1; read -r x y <<<"$xy"; sh_ input tap "$x" "$y" ;;
  long)    xy="$(resolve_xy "$@")" || exit 1; read -r x y <<<"$xy"; sh_ input swipe "$x" "$y" "$x" "$y" 800 ;;
  swipe)   # ad swipe up|down|left|right [ms]  or  ad swipe x1 y1 x2 y2 [ms]
    read -r w h <<<"$(sh_ wm size | tr -d '\r' | tail -1 | awk '{print $3}' | tr x ' ')"
    case "${1:-}" in
      up)    sh_ input swipe $((w/2)) $((h*7/10)) $((w/2)) $((h*3/10)) "${2:-300}" ;;
      down)  sh_ input swipe $((w/2)) $((h*3/10)) $((w/2)) $((h*7/10)) "${2:-300}" ;;
      left)  sh_ input swipe $((w*8/10)) $((h/2)) $((w*2/10)) $((h/2)) "${2:-300}" ;;
      right) sh_ input swipe $((w*2/10)) $((h/2)) $((w*8/10)) $((h/2)) "${2:-300}" ;;
      *)     sh_ input swipe "$@" ;;
    esac ;;
  type)    sh_ input text "$(esc "$*")" ;;   # ASCII only
  key)     for k in "$@"; do sh_ input keyevent "KEYCODE_${k#KEYCODE_}"; done ;;
  back)    sh_ input keyevent KEYCODE_BACK ;;
  home)    sh_ input keyevent KEYCODE_HOME ;;
  launch)  act="$(sh_ cmd package resolve-activity --brief -c android.intent.category.LAUNCHER "$1" | tail -1 | tr -d '\r')"
           [ -n "$act" ] || die "no launcher activity for $1 (installed?)"; sh_ am start -W -n "$act" | grep -E 'Status|TotalTime|Error' ;;

  # --- looking (fast, no LLM) --------------------------------------------------------
  top)     sh_ dumpsys window 2>/dev/null | grep -E 'mCurrentFocus|mFocusedApp' | sed 's/^ *//' ;;
  ui)      ui_dump "$@" ;;
  find)    ui_dump --find "$1" ;;
  shot)    out="${1:-/tmp/ad-$(date +%H%M%S).png}"; mkdir -p "$(dirname "$out")"; a exec-out screencap -p > "$out"; echo "$out" ;;
  record)  # ad record SECONDS [out.mp4]  (screenrecord; frame loop where there is no encoder)
    secs="${1:-10}"; out="${2:-/tmp/ad-$(date +%H%M%S).mp4}"; mkdir -p "$(dirname "$out")"
    if sh_ screenrecord --time-limit "$secs" /sdcard/ad-rec.mp4 2>/dev/null; then
      a pull /sdcard/ad-rec.mp4 "$out" >/dev/null 2>&1 || die "pull of the recording failed"; sh_ rm -f /sdcard/ad-rec.mp4; echo "$out"; exit 0
    fi
    d="$(mktemp -d)"; end=$((SECONDS + secs)); n=0
    while [ $SECONDS -lt $end ]; do a exec-out screencap -p > "$d/$(printf %05d $n).png"; n=$((n+1)); done
    fps=$(( n / secs )); [ "$fps" -lt 1 ] && fps=1
    ffmpeg -loglevel error -y -framerate "$fps" -i "$d/%05d.png" -pix_fmt yuv420p "$out"; rm -rf "$d"; echo "$out ($n frames)" ;;
  zoom)    # ad zoom TEXT|X1,Y1,X2,Y2 [out.png] [--all] [--pad PX] [--scale N]   (close-up of an element at native pixels)
    target="${1:?usage: ad zoom TEXT|x1,y1,x2,y2 [out.png] [--all] [--pad 24] [--scale N]}"; shift
    out=""; all=0; pad=24; scale=""
    while [ $# -gt 0 ]; do
      case "$1" in --all) all=1 ;; --pad) pad="$2"; shift ;; --scale) scale="$2"; shift ;; *) out="$1" ;; esac; shift
    done
    out="${out:-/tmp/ad-zoom-$(date +%H%M%S).png}"; mkdir -p "$(dirname "$out")"
    full="${out%.png}-full.png"
    a exec-out screencap -p > "$full"
    if [[ "$target" =~ ^[0-9]+,[0-9]+,[0-9]+,[0-9]+$ ]]; then boxes="${target//,/ }"
    else boxes="$(ui_dump --find "$target" --bounds)" || die "no node matching '$target' on screen (run 'ad ui')"; fi
    [ "$all" = 1 ] || boxes="$(head -1 <<<"$boxes")"
    read -r W H <<<"$(magick identify -format '%w %h' "$full")"
    n=0
    while read -r x1 y1 x2 y2; do
      [ -n "$x1" ] || continue
      n=$((n+1)); [ "$n" -gt 8 ] && { echo "(stopped at 8 crops)"; break; }
      cx1=$(( x1-pad > 0 ? x1-pad : 0 )); cy1=$(( y1-pad > 0 ? y1-pad : 0 ))
      cx2=$(( x2+pad < W ? x2+pad : W )); cy2=$(( y2+pad < H ? y2+pad : H ))
      cw=$((cx2-cx1)); ch=$((cy2-cy1)); long=$(( cw > ch ? cw : ch ))
      # Image readers shrink anything past ~1568 px, so pick the largest whole factor that stays under it.
      s="${scale:-$(( 1568 / long ))}"; [ "$s" -lt 1 ] && s=1; [ "$s" -gt 6 ] && s=6
      f="$out"; [ "$all" = 1 ] && f="${out%.png}-$n.png"
      magick "$full" -crop "${cw}x${ch}+${cx1}+${cy1}" +repage -filter point -resize "$((s*100))%" "$f"
      echo "$f  element ($x1,$y1)-($x2,$y2), ${s}x"
      # One line per crop, so a reviewer who gets only the images knows real sizes.
      printf '%s\telement %s,%s-%s,%s (%sx%s px on device)\tcrop %s,%s-%s,%s\tscale %sx\ttarget %s\n' \
        "$(basename "$f")" "$x1" "$y1" "$x2" "$y2" "$((x2-x1))" "$((y2-y1))" "$cx1" "$cy1" "$cx2" "$cy2" "$s" "$target" \
        >> "$(dirname "$f")/zoom-index.tsv"
      [ "$long" -gt 1568 ] && echo "  (crop is ${long}px, wider than a reader shows at 1:1; zoom into parts with X1,Y1,X2,Y2)"
    done <<<"$boxes"
    echo "$full  (full screenshot, same moment)" ;;
  frames)  # ad frames SECONDS [outdir] [-- ACTION ...]   (record, then one PNG per distinct frame + sheet.png)
    secs="${1:-3}"; shift || true
    outdir="/tmp/ad-frames-$(date +%H%M%S)"
    if [ $# -gt 0 ] && [ "$1" != "--" ]; then outdir="$1"; shift; fi
    [ "${1:-}" = "--" ] && shift
    mkdir -p "$outdir"; rm -f "$outdir"/f*.png
    "$0" -s "$S" record "$secs" "$outdir/clip.mp4" >/dev/null &
    rp=$!
    if [ $# -gt 0 ]; then sleep 1; "$0" -s "$S" "$@"; fi   # the action under test, once recording runs
    wait "$rp" || die "recording failed"
    # screenrecord only writes a frame when the screen changes, so passthrough keeps each distinct frame.
    ffmpeg -loglevel error -y -i "$outdir/clip.mp4" -fps_mode passthrough "$outdir/f%03d.png"
    n=$(ls "$outdir"/f*.png 2>/dev/null | wc -l)
    [ "$n" -gt 0 ] || die "no frames extracted from $outdir/clip.mp4"
    if [ "$n" -gt 90 ]; then rm -f "$outdir"/f*.png; ffmpeg -loglevel error -y -i "$outdir/clip.mp4" -vf fps=30 "$outdir/f%03d.png"; fi
    prev=""; for f in "$outdir"/f*.png; do   # drop exact repeats of the previous frame; gaps in numbering mark time
      h="$(magick "$f" -depth 8 rgb:- | md5sum | cut -c1-32)"; [ "$h" = "$prev" ] && rm -f "$f"; prev="$h"
    done
    n=$(ls "$outdir"/f*.png | wc -l)
    step=$(( (n + 11) / 12 ))
    magick montage $(ls "$outdir"/f*.png | awk -v s="$step" '(NR-1) % s == 0') -tile 4x -geometry 360x+6+6 -background '#808080' "$outdir/sheet.png"
    echo "$outdir: $n frames (f001.png ...), sheet.png = 12 evenly spaced frames, clip.mp4" ;;

  # --- apps --------------------------------------------------------------------------
  install) # ad install app.apk [--fresh] [--direct]   (--fresh uninstalls first so the first-run flow shows)
    # A target with a drop= field in $TARGETS installs through the device-drops repo (see
    # drop_install); --direct, an emulator or a target without one pushes over adb.
    apk="${1:?ad: install needs an APK}"; shift; fresh=""; direct=""
    for x in "$@"; do case "$x" in --fresh) fresh=1 ;; --direct) direct=1 ;; *) die "install: unknown option $x" ;; esac; done
    [ -f "$apk" ] || die "install: no such file: $apk"
    alias="$(target_field "$TARGET" drop)"; [ -n "$direct" ] && alias=""
    if [ -n "$fresh" ]; then
      pkg="$(pkg_of_apk "$apk" 2>/dev/null || true)"
      # The drop route runs through the device's Termux: uninstalling that app first would take
      # the ssh server and gh with it, so a fresh install of it goes over adb.
      [ -n "$alias" ] && [ "$pkg" = "$(target_field "$TARGET" drop_pkg | sed 's/^$/com.termux/')" ] \
        && die "install --fresh of $pkg would remove the drop carrier on $TARGET; use --fresh --direct"
      [ -n "$pkg" ] && sh_ pm uninstall "$pkg" >/dev/null 2>&1 || true
    fi
    if [ -n "$alias" ] && [ -z "$direct" ]; then
      drop_install "$apk" "$alias" "$(target_field "$TARGET" drop_pkg)"
    else
      a install -r --no-incremental "$apk"
    fi ;;
  open)    sh_ am start -W -a android.intent.action.VIEW -d "$1" | grep -E 'Status|Activity|Error' ;;  # deep link
  stop)    sh_ am force-stop "$1" ;;
  kill)    sh_ am kill "$1" ;;      # background process death; app must be in background
  clear)   sh_ pm clear "$1" ;;     # first-run state, keeps the APK
  pkgs)    # ad pkgs [FILTER] [--all]
    f=-3; q=""; for x in "$@"; do [ "$x" = "--all" ] && f="" || q="$x"; done
    sh_ pm list packages $f | sed 's/package://' | tr -d '\r' | grep -i -- "$q" || true ;;
  perm)    sh_ pm "$2" "$1" "$3" ;;  # ad perm PKG grant|revoke android.permission.X
  perms)   sh_ dumpsys package "$1" | sed -n '/runtime permissions:/,/^$/p' | head -40 ;;

  # --- conditions: no argument prints the current value; note it, then restore exactly that --
  night)   [ $# -eq 0 ] && { sh_ cmd uimode night | tr -d '\r'; exit; }; sh_ cmd uimode night "$1" ;;   # yes|no
  font)    [ $# -eq 0 ] && { sh_ settings get system font_scale | tr -d '\r'; exit; }
           sh_ settings put system font_scale "$1" ;;                # 0.85 1.0 1.15 1.3 1.5 1.8
  anim)    [ $# -eq 0 ] && { sh_ settings get global window_animation_scale | tr -d '\r'; exit; }
           for k in window_animation_scale transition_animation_scale animator_duration_scale; do sh_ settings put global $k "$1"; done ;;
  locale)  # ad locale PKG [ar-KW|""]   (per app, Android 13+; no value prints it, "" resets)
           [ $# -eq 1 ] && { sh_ cmd locale get-app-locales "$1" --user 0 | tr -d '\r'; exit; }
           sh_ cmd locale set-app-locales "$1" --user 0 --locales "${2:-}" ;;
  airplane) [ $# -eq 0 ] && { sh_ settings get global airplane_mode_on | tr -d '\r'; exit; }
           sh_ cmd connectivity airplane-mode "$1" ;;               # enable|disable
  density) [ $# -eq 0 ] && { sh_ wm density | tr -d '\r'; exit; }; sh_ wm density "$1" ;;   # 420 | reset
  size)    [ $# -eq 0 ] && { sh_ wm size | tr -d '\r'; exit; }; sh_ wm size "$1" ;;         # 1080x2412 | reset

  # --- logs ----------------------------------------------------------------------------
  logcat)  # ad logcat PKG [extra logcat args]   (pid-filtered)
    pkg="${1:-}"; shift || true
    if [ -z "$pkg" ] || [ "$pkg" = "--all" ]; then a logcat -v time "$@"; else
      p="$(sh_ pidof "$pkg" 2>/dev/null | tr -d '\r')" || true
      [ -n "$p" ] && a logcat -v time --pid="$p" "$@" || a logcat -v time "$@" | grep -F "$pkg"
    fi ;;
  logclear) a logcat -c ;;
  crash)   a logcat -d -b crash -v time | tail -80 ;;

  runas)   # ad -s DEVICE runas PKG "command"   (runs inside a debuggable app's own uid and data dir; prints output)
    pkg="${1:?ad -s DEVICE runas PKG \"command\"}"; shift
    [ $# -gt 0 ] || die "usage: ad -s DEVICE runas PKG \"command\"   (set AD_RUNAS_PRELUDE for an env prefix)"
    printf '%s\n%s\n' "${AD_RUNAS_PRELUDE:-}" "$*" | a shell run-as "$pkg" sh -s ;;

  # --- raw -------------------------------------------------------------------------------
  adb)     a "$@" ;;
  shell)   sh_ "$@" ;;

  help|*)
    sed -n '/^# ad —/,/^set -e/p' "$0" | head -3
    grep -E '^  [a-z|-]+\)' "$0" | sed -E 's/^  ([a-z|-]+)\).*/  \1/' | tr '\n' ' '; echo
    echo "  lease acquire|release|status: one driver per device; changing a device needs its lease"
    echo "  emulator pool: -s emu (writable) and emu2 (read-only, reset on stop); 2 slots, no more"
    echo "  lease acquire --any [--for MIN] [--wait] \"purpose\": lease the first free emulator slot"
    echo "  Docs: $HERE/SKILL.md" ;;
esac
